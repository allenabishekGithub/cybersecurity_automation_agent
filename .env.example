RAG_IMAGE=rag-assistant:dev
MININET_IMAGE=mininet-sim:dev
APP_PORT=8501

# Passed into the container so the Streamlit UI pre-populates the API key field.
# The user can still override it in the sidebar at runtime.
OPENAI_API_KEY=

K8S_NAMESPACE=rag-agent
K8S_IMAGE_LOAD_MODE=microk8s   # microk8s | none | kind | minikube | registry
K8S_IMAGE_REGISTRY=localhost:32000
KIND_CLUSTER_NAME=kind
